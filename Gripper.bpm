Function Open()
  Motor.Move("D", -40, 300 , "True")
EndFunction

Function Close()
  Motor.SchedulePower("D", 80, 0, 300, 0, "True")
  Time.Reset1()
  
  While (Motor.IsBusy("D") = "True") And (Time.Get1() < 1000)
    Program.Delay(10)
  EndWhile
  Motor.Stop("D", "True")
EndFunction

Function Flip()
  _Flip(80)
EndFunction


Function Flip2()
  _Flip(-80) 
EndFunction


Function _Flip(in number power)
  Motor.SchedulePower("A", power, 20, 285, 150, "True")
  ' Сбрасываем таймер
  Time.Reset1()
  
  While (Motor.IsBusy("A") = "True") And (Time.Get1() < 2000)
    Program.Delay(10)
  EndWhile
  
  Motor.Stop("A", "True")
EndFunction