folder "prjs" "robotyagi"

Sensor.SetMode(2, 3)
Sensor.SetMode(3, 3)

LCD.Clear()
LCD.Text(1, 20, 20, 2, "CALIBRATION")
LCD.Text(1, 10, 50, 1, "1. Put on BLACK")
LCD.Text(1, 10, 70, 1, "and press ENTER (E)")

Buttons.Flush()
Buttons.Wait()

black_left = Sensor2.Raw1()
black_right = Sensor3.Raw1()

LCD.Clear()
LCD.Text(1, 20, 20, 2, "CALIBRATION")
LCD.Text(1, 10, 50, 1, "Black saved")
Program.Delay(1000)

LCD.Clear()
LCD.Text(1, 20, 20, 2, "CALIBRATION")
LCD.Text(1, 10, 50, 1, "2. Put on WHITE")
LCD.Text(1, 10, 70, 1, "and press ENTER (E)")

Buttons.Flush()
Buttons.Wait()

white_left = Sensor2.Raw1()
white_right = Sensor3.Raw1()

filename = "robotyagi/calib.txt"

handle = EV3File.OpenWrite(filename)
EV3File.WriteLine(handle, black_left)  ' 1-я строка: мин левого
EV3File.WriteLine(handle, white_left)  ' 2-я строка: макс левого
EV3File.WriteLine(handle, black_right) ' 3-я строка: мин правого
EV3File.WriteLine(handle, white_right) ' 4-я строка: макс правого
EV3File.Close(handle)

LCD.Clear()
LCD.Text(1, 10, 40, 2, "SUCCESS!")
LCD.Text(1, 10, 70, 1, "Saved to calib.txt")
Program.Delay(2000)