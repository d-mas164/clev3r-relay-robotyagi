'Реализация работы с тележкой
'---------------------------------
import "Sound"
import "Light"
import "AdvMtCtrls"

number left_sensor
number right_sensor
number BlackThreshold
number wheelDiameter

Function Initialize()
  MotorBC.Off()
  ' Инициализация датчиков и портов
  Motor.Invert("C") ' Инвертируем левый мотор, если робот едет назад
  Motor.ResetCount("BC")
  MotorB.IsMedium()
  MotorC.IsMedium()
  
  BlackThreshold = 12
  wheelDiameter = 100
  ' Подберите kp (пропорциональный) и kd (дифференциальный)
  AdvMtCtrls.PD_Config(0.87, 2.8, 80)

  ' применение калибровки датчиков
  filename = "robotyagi/calib.txt"
  handle = EV3File.OpenRead(filename)
  max_2 = EV3File.ConvertToNumber(EV3File.ReadLine(handle))
  min_2 = EV3File.ConvertToNumber(EV3File.ReadLine(handle))
  max_3 = EV3File.ConvertToNumber(EV3File.ReadLine(handle))
  min_3 = EV3File.ConvertToNumber(EV3File.ReadLine(handle))
  EV3File.Close(handle)
  Light.Config(2, min_2, max_2)
  Light.Config(3, min_3, max_3)
EndFunction

Function DriveTo()
  While "true"
    _ReadSensors()
    _CalculateMove()
    'Program.Delay(5) ' Небольшая задержка для стабильности цикла
  EndWhile
EndFunction

Function _CalculateMove()
  ' Рассчитываем управление для моторов B и C на основе ошибки между датчиками
  AdvMtCtrls.PD(left_sensor, right_sensor, motor_B_speed, motor_C_speed)
  If motor_B_speed < -20 Then
    motor_B_speed=-20
  EndIf
  If motor_C_speed < -20 Then
    motor_C_speed=-20
  EndIf

  ' Подаем команду на моторы
  Motor.StartPower("B", motor_B_speed)
  Motor.StartPower("C", motor_C_speed)
  
EndFunction

Function _ReadSensors()
  Light.getS3(left_sensor_t)
  Light.getS2(right_sensor_t)
  left_sensor=left_sensor_t
  right_sensor=right_sensor_t
EndFunction

Function _DistanceToDegrees(in number distance_in, out number targetDeg_out)
  ' Расчет длины окружности колеса
  wheelCircumference = Math.Pi * wheelDiameter
  ' Перевод расстояния в градусы энкодера
  targetDeg_out = (distance_in / wheelCircumference) * 360
EndFunction

Function Stop()
  Motor.Stop("BC", "True") ' Мгновенное торможение моторов B и C
EndFunction

Function DriveToCross()
  While "true"
    _ReadSensors()
    If left_sensor < BlackThreshold And right_sensor < BlackThreshold Then
      break
    EndIf
    _CalculateMove()
    Program.Delay(10) ' Небольшая задержка для стабильности цикла
    
  EndWhile
EndFunction

Function DriveToCrossWithPower(in number pwr)
  original_pwr = AdvMtCtrls.pwr
  AdvMtCtrls.pwr = pwr
  DriveToCross()
  AdvMtCtrls.pwr = original_pwr
EndFunction

Function DriveDistance(in number totalDist_in, in number minPwr_in, in number acc_dist_in, in number dec_dist_in)
  _DistanceToDegrees(totalDist_in, totalDistDegrees)
  _DistanceToDegrees(acc_dist_in, accDistDegrees)
  _DistanceToDegrees(dec_dist_in, decDistDegrees)
  ' Настройка плавного торможения на дистанцию totalDist_in градусов
  ' Параметры: мин_мощность, макс_мощность, разгон_путь, торможение_путь, всего_путь
  AdvMtCtrls.AccTwoEnc_Config(minPwr_in, AdvMtCtrls.pwr, accDistDegrees, decDistDegrees, totalDistDegrees)
  Motor.ResetCount("BC")
  is_done = 0
  current_pwr = 0
  
  While is_done = 0
    _ReadSensors()
    
    ' Получаем текущую базовую мощность (плавный разгон/торможение) по энкодерам B и C
    AdvMtCtrls.AccTwoEnc(Motor.GetCount("B"), Motor.GetCount("C"), current_pwr, is_done)
    
    ' Рассчитываем управление для моторов B и C на основе ошибки между датчиками
    ' Передаем текущую скорость current_pwr как базовую
    AdvMtCtrls.PD_pwrIn(current_pwr, left_sensor, right_sensor, motor_B_speed, motor_C_speed)
    
    If motor_B_speed < -20 Then
      motor_B_speed = -20
    EndIf
    If motor_C_speed < -20 Then
      motor_C_speed = -20
    EndIf

    ' Подаем команду на моторы
    Motor.StartPower("B", motor_B_speed)
    Motor.StartPower("C", motor_C_speed)
    Program.Delay(10)
  EndWhile
EndFunction

Function Otezd()
  MotorBC.StartPower(-40)
  Program.Delay(700)
EndFunction
