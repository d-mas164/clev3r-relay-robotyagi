folder "prjs" "robotyagi"

import "Truck"
import "Gripper"
import "Sound"
import "Comms"

Comms.Initialize()
Truck.Initialize()

If Comms.IsLeadBrick = 0 Then
  Comms.PassRelay()
  Goto relayPass
Else
  Comms.WaitForPassRelay()
  Gripper.Close()
  Goto firstPass
EndIf

While "True"
  Comms.WaitForPassRelay()
  Program.Delay(300)
  Motor.Move("BC", -10,30 , "True") '300
  
  Thread.Run=FLIP
  ' подождать пока захват схватит палочку
  Program.Delay(800)
  
  firstPass:
  Comms.TakeRelay()
  
  Truck.DriveDistance(1800, 40, 500, 0) ' Проехать 1800 мм - разгон 500 мм со скорости 30
  EV3.SetLEDColor("RED", "NORMAL")
  
  ' Поворот после горки
  Truck.DriveDistance(200, 50, 0, 200) ' Проехать 200 мм - тормозим 200 мм до скорости 50
  EV3.SetLEDColor("ORANGE", "NORMAL")
  Truck.DriveDistance(3000, 50, 100, 0) ' Проехать 2500 мм - разгон 100 мм со скорости 50
  EV3.SetLEDColor("GREEN", "NORMAL")
  
  Truck.DriveToCross()
  
  ' Зона передачи
  Thread.Run=DriveToRobot
  Gripper.Open()
  Comms.PassRelay()
  Truck.StepBack()
  Truck.Stop()
  
  relayPass:
  Comms.WaitForTakeRelay()
  Program.Delay(2000)
  Truck.DriveToCrossWithPower(40)
  Truck.Stop()
  Gripper.Close()
  Gripper.Flip2()
  Gripper.Open()
EndWhile

Sub FLIP
  Gripper.Close()
  Gripper.Flip()
EndSub

Sub DriveToRobot
  Truck.DriveDistance(250, 20, 0, 250)  ' тормозим 250мм до скорости 20
  Truck.Stop()
EndSub

' --- План ---
' 1. Базовый сценарий - ожидание 11 передач
'   AdvMtCtrls.PD_Config(0.8, 2.8, 80)
'   отъезд назад при приеме передачи
'   срезка скорости в -5

' 2. Если баpовый не работает (вылетаем в поворотах)
'   Увеличиваем Kp - 0.85 - 0.87
'   убрать срезку скорости

' 3. Встает на козла
'   Увеличиваем задержку перед стартовм до 1000 - 1500

' 4. Ускорение относительно базового сценария
'   Увеличиваем срезку скорости до 0. В двух местах
'   Увеличиваем скорость до 85
'   Убираем отъезд робота при приеме передачи
'   Укоротить торможение в зоне передачи до 235