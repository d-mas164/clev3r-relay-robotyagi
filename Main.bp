folder "prjs" "robotyagi"

import "Truck"
import "Gripper"
import "Sound"
import "Comms"

Comms.Initialize()
Truck.Initialize()

If Comms.IsLeadBrick = 0 Then
  Goto relayPass
EndIf

While "True"
  Comms.WaitForPassRelay()
  Motor.Move("BC", -10,30 , "True") '300
  Gripper.Close()
  Thread.Run=FLIP
  Comms.TakeRelay()
  
  Truck.DriveDistance(6000, 20, 200, 0)
  Truck.DriveToCross()
  
  ' Зона передачи
  Truck.SlowDownWithStallDetection(20,100) ' тормозим 300мм до скорости 20
  
  Truck.Stop()
  Gripper.Open()
  Truck.SlowDownWithStallDetection(20,165) ' тормозим 300мм до скорости 20
  Truck.Stop()
  Truck.Otezd()
  Truck.Stop()
  relayPass:
  Comms.PassRelay()

  Comms.WaitForTakeRelay()
  Program.Delay(2000)
  Truck.DriveToCross()
  Truck.Stop()
  Gripper.Close()
  Gripper.Flip2()
  Gripper.Open()
EndWhile

Sub FLIP
  Gripper.Flip()
EndSub
