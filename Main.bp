folder "prjs" "robotyagi"

import "Truck"
import "Gripper"
import "Sound"
import "Comms"

Comms.Initialize()
Truck.Initialize()

Lead= "Ivan"
pas = "Dima"
If EV3.BrickName <> pas Then
Goto relayPass
EndIf

While "True"
 Comms.WaitForPassRelay()
  Gripper.Close()
  Thread.Run=FLIP
  Comms.TakeRelay()
  
  'Truck.SlowDown(100,6000) 'поменять
  
  Truck.DriveToCross()
  
  'Горка
  'Truck.SlowDown(60,110) ' тормозим 60мм до скорости 
  
  ' Бордюры
  'Truck.SlowDown(60,150) ' тормозим 60мм до скорости 20
  'Truck.DriveToCross()
  
  ' Зона передачи
  Truck.SlowDownWithStallDetection(20,300) ' тормозим 300мм до скорости 20
  Truck.Stop()
  Gripper.Open()
  Truck.Otezd()
  relayPass:
  Comms.PassRelay()
  Truck.Stop()
  Comms.WaitForTakeRelay()
  Truck.DriveToCrossAndStop()
  Gripper.Close()
  Gripper.Flip2()
  Gripper.Open()
EndWhile





Sub FLIP
  Gripper.Flip()
EndSub
