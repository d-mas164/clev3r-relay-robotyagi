number s2min
number s2max
number s3min
number s3max

Function Config(in number port, in number min, in number max)
  If port = 2 Then
    s2min = min
    s2max = max
  ElseIf port = 3 Then
    s3min = min
    s3max = max
  EndIf
  Sensor.SetMode(port, 3)
EndFunction

Function getS2(out number value)
  raw = Sensor2.Raw1()
  If  raw < s2min Then
    value = 100
  ElseIf raw > s2max Then
    value = 0
  Else
    value = ((raw - s2max) * 100) / (s2min - s2max)
  EndIf
EndFunction

Function getS3(out number value)
  raw = Sensor3.Raw1()
  If  raw < s3min Then
    value = 100
  ElseIf raw > s3max Then
    value = 0
  Else
    value = ((raw - s3max) * 100) / (s3min - s3max)
  EndIf
EndFunction
